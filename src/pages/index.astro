---
import Base from '../layouts/Base.astro';
import AuditProcess from '../components/AuditProcess.astro';
import AuditPreview from '../components/AuditPreview.astro';
import AuditFaq from '../components/AuditFaq.astro';
import '../styles/audit-experience.css';
import IndustryExplorer from '../components/IndustryExplorer.astro';
import '../styles/interactions.css';
import { services } from '../data/site';
---
<Base title="Free AI Search Visibility Audit" description="Request a free AI search visibility audit from SE LABS. Find gaps in how your website can be discovered, understood and cited, with three practical priorities.">
  <section class="hero wrap">
    <div class="hero-copy"><h1>FREE AI<br />VISIBILITY<br />AUDIT.</h1><div class="hero-bottom"><p><strong>When customers ask AI,<br />is your website ready?</strong><br />Get an automated website check with evidence and practical priorities for AI search readiness.</p><form class="audit-start" action="/audit/" method="get"><input type="hidden" name="interest" value="diagnosis" /><label for="audit-website">Your website URL</label><input id="audit-website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourwebsite.com" required maxlength="500" /><button class="button" type="submit">Run my free AI audit <span aria-hidden="true">↗</span></button></form><p class="audit-note">Free automated check. No email or account required.</p><a class="text-link hero-secondary" href="#audit-preview">Explore what’s included ↓</a></div></div>
    <AuditPreview />
  </section>
  <AuditProcess />
  <AuditFaq />
  <section class="intro wrap"><p>SE LABS is a Sydney digital marketing studio for Australian ecommerce brands, restaurants and local businesses.</p><p>We bring websites, SEO, advertising, social media and email together—with practical automation for the work that repeats.</p></section>
  <section class="section wrap" id="services"><div class="section-heading"><h2>Good on their own.<br /><em>Better together.</em></h2><a class="text-link" href="/services/">Explore our services ↗</a></div><div class="service-list">{services.map((s, i) => <a class="service-row" href={`/services/${s.slug}/`}><span class="number">0{i + 1}</span><h3>{s.name}</h3><p>{s.short}</p><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></section>

  <IndustryExplorer />
  <section class="closing wrap" id="contact"><h2>GET YOUR FREE<br /><em>AI AUDIT.</em></h2><a class="button" href="/audit/">Run my free AI audit ↗</a></section>
</Base>

<script>
import { animate } from "motion/mini";
import { normalizeWebsite } from '../lib/audit-url.mjs';
const start = document.querySelector<HTMLFormElement>('.audit-start')!;
const websiteInput = start.querySelector<HTMLInputElement>('#audit-website')!;
websiteInput.addEventListener('input', () => websiteInput.setCustomValidity(''));
start.addEventListener('submit', event => {
 try { websiteInput.value = normalizeWebsite(websiteInput.value); }
 catch { event.preventDefault(); websiteInput.setCustomValidity('Enter a public website such as example.com.'); websiteInput.reportValidity(); }
});
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(group => {
 const controls = group.querySelector<HTMLElement>('[data-tab-controls]')!;
 const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-tab]')];
 const panels = [...group.querySelectorAll<HTMLElement>('[data-panel]')];
 function select(index: number, focus = false) {
  buttons.forEach((button,i) => { button.setAttribute('aria-selected',String(i===index)); button.tabIndex=i===index?0:-1; });
  panels.forEach((panel,i) => {
   panel.hidden = i!==index;
   if(i===index && !reducedMotion.matches) animate(panel,{opacity:[.5,1],transform:['translateY(6px)','translateY(0)']},{duration:.22,ease:'easeOut'});
  });
  group.dataset.active=String(index);
  if(focus) buttons[index].focus();
 }
 controls.setAttribute('role','tablist');
 buttons.forEach((button,i) => {
  button.setAttribute('role','tab');
  panels[i].setAttribute('role','tabpanel');
  panels[i].setAttribute('aria-labelledby',button.id);
  panels[i].tabIndex=0;
  button.addEventListener('click',()=>select(i));
  button.addEventListener('keydown',event=>{
   if(event.metaKey || event.ctrlKey || event.altKey) return;
   const keys=['ArrowRight','ArrowLeft','Home','End'];
   if(!keys.includes(event.key)) return;
   event.preventDefault();
   const next=event.key==='Home'?0:event.key==='End'?buttons.length-1:(i+(event.key==='ArrowRight'?1:-1)+buttons.length)%buttons.length;
   select(next,true);
  });
 });
 select(0);
 controls.hidden=false;
 group.querySelectorAll<HTMLElement>('[data-enhanced-only]').forEach(el=>el.hidden=false);
 group.classList.add('is-interactive');
});
// Animate only on entry; content is never hidden while waiting for JavaScript.
if ('IntersectionObserver' in window) {
 const observer=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{
   if(!entry.isIntersecting) return;
   if(!reducedMotion.matches) animate(entry.target,{opacity:[.7,1],transform:['translateY(12px)','translateY(0)']},{duration:.4,ease:'easeOut'});
   observer.unobserve(entry.target);
  });
 },{threshold:.12});
 document.querySelectorAll('.section-heading,.lab-feature,.closing,.intro').forEach(el=>observer.observe(el));
}
</script>
