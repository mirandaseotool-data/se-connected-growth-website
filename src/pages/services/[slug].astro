---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/site';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Base title={service.title} description={service.description} service={service.name}>
<section class="page-hero wrap"><h1>{service.name}<span class="heading-serif">{service.short}</span></h1><p class="lead">{service.intro}</p><a class="button" href={`/contact/?interest=${service.slug}`}>Discuss your business ↗</a></section>
<section class="article-grid wrap section"><aside><h2>Is this for you?</h2><p>{service.fit}</p></aside><div><h2>What we work on</h2><div class="work-list">{service.work.map(([name, copy], i) => <article><span class="number">0{i + 1}</span><div><h3>{name}</h3><p>{copy}</p></div></article>)}</div><div class="deliverables"><h2>What you receive</h2><ul>{service.deliverables.map(item => <li>{item}</li>)}</ul><p>{service.boundary}</p></div><h2>Questions, answered.</h2><div class="faq">{service.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="callout wrap"><h2>Make the next step a useful one.</h2><a class="button" href={`/contact/?interest=${service.slug}`}>Start a conversation ↗</a><a class="text-link" href="/services/">Explore all services</a></section>
</Base>
